
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function patientPath(patientId) {
      return /databases/$(database)/documents/patients/$(patientId);
    }

    function linkRequestPath(uid) {
      return /databases/$(database)/documents/patientAccountLinkRequests/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && userData(request.auth.uid).role == 'admin'
        && (!userData(request.auth.uid).keys().hasAny(['active'])
          || userData(request.auth.uid).active == true);
    }

    function isDentist() {
      return signedIn()
        && userExists(request.auth.uid)
        && userData(request.auth.uid).role == 'dentist'
        && (!userData(request.auth.uid).keys().hasAny(['active'])
          || userData(request.auth.uid).active == true);
    }

    // A patient must have an approved user-to-patient mapping.
    function isPatient() {
      return signedIn()
        && userExists(request.auth.uid)
        && userData(request.auth.uid).role == 'patient'
        && userData(request.auth.uid).active == true
        && userData(request.auth.uid).patient_id is string
        && exists(patientPath(userData(request.auth.uid).patient_id))
        && get(patientPath(userData(request.auth.uid).patient_id)).data.auth_uid
          == request.auth.uid
        && get(patientPath(userData(request.auth.uid).patient_id)).data.id
          == userData(request.auth.uid).patient_id;
    }

    function patientIdFor(uid) {
      return userData(uid).patient_id;
    }

    // New Patient Portal accounts must create users/{uid} and
    // patients/{PT-ID} together in one atomic batch.
    function validNewPatientUser(uid) {
      return signedIn()
        && request.auth.uid == uid
        && !userExists(uid)
        && request.resource.data.keys().hasAll([
          'role', 'active', 'patient_id', 'patient_doc_id',
          'name', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'role', 'active', 'patient_id', 'patient_doc_id',
          'name', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'patient'
        && request.resource.data.active == true
        && request.resource.data.patient_id is string
        && request.resource.data.patient_id.matches('^PT-[A-Z0-9]{8}$')
        && request.resource.data.patient_doc_id
          == request.resource.data.patient_id
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && getAfter(patientPath(request.resource.data.patient_id)).data.auth_uid
          == uid
        && getAfter(patientPath(request.resource.data.patient_id)).data.id
          == request.resource.data.patient_id;
    }

    function validNewPatientRecord(patientId) {
      return signedIn()
        && !exists(patientPath(patientId))
        && patientId.matches('^PT-[A-Z0-9]{8}$')
        && request.resource.data.keys().hasAll([
          'id', 'auth_uid', 'name', 'email', 'phone',
          'dob', 'gender', 'address', 'status',
          'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'auth_uid', 'name', 'email', 'phone',
          'dob', 'gender', 'address', 'status',
          'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == patientId
        && request.resource.data.auth_uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.dob is string
        && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.gender in ['Male', 'Female']
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 3
        && request.resource.data.address.size() <= 500
        && request.resource.data.phone is string
        && request.resource.data.status == 'Active'
        && request.resource.data.source == 'patient-app'
        && getAfter(userPath(request.auth.uid)).data.role == 'patient'
        && getAfter(userPath(request.auth.uid)).data.active == true
        && getAfter(userPath(request.auth.uid)).data.patient_id == patientId
        && getAfter(userPath(request.auth.uid)).data.patient_doc_id == patientId;
    }

    function dentistUid() {
      return isDentist() ? request.auth.uid : '';
    }

    function dentistProfileId(uid) {
      return userExists(uid) && userData(uid).keys().hasAny(['dentistId'])
        ? userData(uid).dentistId : uid;
    }

    // The parameter is now the permanent clinic Patient ID, not Firebase UID.
    function dentistAssignedToPatient(patientId) {
      return isDentist()
        && exists(patientPath(patientId))
        && get(patientPath(patientId)).data.keys()
          .hasAny(['assigned_dentist_uids'])
        && get(patientPath(patientId)).data.assigned_dentist_uids
          .hasAny([request.auth.uid, dentistUid()]);
    }

    function canAccessPatient(patientId) {
      return isAdmin()
        || (isPatient() && patientIdFor(request.auth.uid) == patientId)
        || dentistAssignedToPatient(patientId);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && (
          (isPatient() && data.patient_uid == request.auth.uid)
          || (isDentist() && data.dentist_uid == request.auth.uid)
        );
    }

    function isAssignedAppointment(data) {
      return isDentist()
        && data.dentist_id == dentistUid()
        && data.status in ['Confirmed', 'Rescheduled', 'Completed'];
    }

    function activeDentistAccount(uid) {
      let path = /databases/$(database)/documents/dentists/$(dentistProfileId(uid));
      return userExists(uid)
        && userData(uid).role == 'dentist'
        && (!userData(uid).keys().hasAny(['active'])
          || userData(uid).active == true)
        && exists(path)
        && get(path).data.auth_uid == uid
        && (!get(path).data.keys().hasAny(['active'])
          || get(path).data.active == true)
        && (!get(path).data.keys().hasAny(['status'])
          || get(path).data.status == 'Active');
    }

    // USER ACCOUNTS
    match /users/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid);

      allow create: if isAdmin() || validNewPatientUser(uid);
      allow update, delete: if isAdmin();
    }

    // PERMANENT CLINIC PATIENT RECORDS
    match /patients/{patientId} {
      allow read: if canAccessPatient(patientId);

      allow create: if isAdmin() || validNewPatientRecord(patientId);

      allow update: if isAdmin()
        || (
          isPatient()
          && patientIdFor(request.auth.uid) == patientId
          && resource.data.auth_uid == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.auth_uid == resource.data.auth_uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phone', 'address', 'emergency_contact',
            'emergency_phone', 'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    // DENTIST PROFILES
    match /dentists/{dentistUidDoc} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isDentist()
          && (request.auth.uid == dentistUidDoc
            || resource.data.auth_uid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email', 'phone', 'address', 'description',
            'photo_url', 'profile_photo_url',
            'updated_at', 'updatedAt'
          ])
        );
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /clinicSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.status == 'Published'
          && (
            (isPatient()
              && resource.data.audience in [
                'All Patients', 'Existing Patients', 'New Patients'
              ])
            || (isDentist()
              && resource.data.audience in ['All Dentists', 'All'])
          )
        );
      allow write: if isAdmin();
    }

    // APPOINTMENTS
    match /appointments/{appointmentId} {

      allow read: if isAdmin()
        || (
          isPatient()
          && resource.data.patient_uid == request.auth.uid
          && resource.data.patient_id == patientIdFor(request.auth.uid)
        )
        || isAssignedAppointment(resource.data);

      function validPatientAppointmentCreate() {
        return isPatient()

          // Only the fields produced by the Patient Portal booking
          // repository are accepted.
          && request.resource.data.keys().hasAll([
            'id',
            'patient_id',
            'patient_uid',
            'patient_doc_id',
            'patient',
            'patient_name',
            'patient_snapshot',
            'dentist_id',
            'dentist',
            'service_id',
            'service_ids',
            'service',
            'date',
            'time',
            'time_24h',
            'duration',
            'status',
            'payment_method',
            'payment_status',
            'payment_provider',
            'payment_method_id',
            'notes',
            'amount',
            'source',
            'booking_source',
            'createdAt',
            'updatedAt'
          ])

          && request.resource.data.keys().hasOnly([
            'id',
            'patient_id',
            'patient_uid',
            'patient_doc_id',
            'patient',
            'patient_name',
            'patient_snapshot',
            'dentist_id',
            'dentist',
            'service_id',
            'service_ids',
            'service',
            'date',
            'time',
            'time_24h',
            'duration',
            'status',
            'payment_method',
            'payment_status',
            'payment_provider',
            'payment_method_id',
            'notes',
            'amount',
            'source',
            'booking_source',
            'createdAt',
            'updatedAt'
          ])

          // Appointment document identity.
          && request.resource.data.id == appointmentId

          // Patient ownership and permanent clinic ID.
          && request.resource.data.patient_uid == request.auth.uid
          && request.resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.patient_doc_id == patientIdFor(request.auth.uid)

          // Patient information.
          && request.resource.data.patient is string
          && request.resource.data.patient_name is string
          && request.resource.data.patient_snapshot is map
          && request.resource.data.patient_snapshot.name
            == request.resource.data.patient_name

          // Dentist must be an active, linked dentist account.
          && request.resource.data.dentist_id is string
          && request.resource.data.dentist_id.size() > 0
          && activeDentistAccount(request.resource.data.dentist_id)
          && request.resource.data.dentist is string

          // At least one selected service is required.
          && request.resource.data.service_id is string
          && request.resource.data.service_id.size() > 0
          && request.resource.data.service_ids is list
          && request.resource.data.service_ids.size() > 0
          && request.resource.data['service'] is string

          // Schedule information.
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.time is string
          && request.resource.data.time.size() > 0
          && request.resource.data.time_24h is string
          && request.resource.data.time_24h.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.duration is int
          && request.resource.data.duration > 0

          // Appointment approval.
          && request.resource.data.status == 'Pending'

          // Payment method must exist in Admin's paymentMethods collection
          // and must currently be Active.
          && request.resource.data.payment_method is string
          && request.resource.data.payment_method_id is string
          && request.resource.data.payment_method_id.size() > 0
          && exists(
            /databases/$(database)/documents/paymentMethods/$(request.resource.data.payment_method_id)
          )
          && get(
            /databases/$(database)/documents/paymentMethods/$(request.resource.data.payment_method_id)
          ).data.status == 'Active'
          && get(
            /databases/$(database)/documents/paymentMethods/$(request.resource.data.payment_method_id)
          ).data.name == request.resource.data.payment_method

          // Booking does not process payment.
          && request.resource.data.payment_status == 'Unpaid'
          && request.resource.data.payment_provider == 'Manual'

          // Amount and additional information.
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.notes is string

          // Source and timestamps.
          && request.resource.data.source == 'patient-app'
          && request.resource.data.booking_source == 'patient-app'
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      allow create: if isAdmin()
        || validPatientAppointmentCreate();

      allow update: if isAdmin()

        // Patient cancellation.
        || (
          isPatient()
          && resource.data.patient_uid == request.auth.uid
          && resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.patient_uid == resource.data.patient_uid
          && request.resource.data.patient_id == resource.data.patient_id
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancelled_by',
            'cancelled_at',
            'cancellation_reason',
            'updatedAt'
          ])
        )

        // Patient reschedule request.
        || (
          isPatient()
          && resource.data.patient_uid == request.auth.uid
          && resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.patient_uid == resource.data.patient_uid
          && request.resource.data.patient_id == resource.data.patient_id
          && request.resource.data.status == resource.data.status
          && request.resource.data.reschedule_request_status == 'Pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reschedule_request_status',
            'requested_date',
            'requested_time',
            'requested_time_24h',
            'reschedule_reason',
            'reschedule_requested_at',
            'updatedAt'
          ])
        )

        // Dentist consultation completion.
        || (
          isAssignedAppointment(resource.data)
          && request.resource.data.dentist_id == resource.data.dentist_id
          && request.resource.data.status == 'Completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'consultation',
            'completedAt',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || (isDentist() && resource.data.dentist_id == dentistUid())
        || (isPatient() && resource.data.patient_uid == request.auth.uid);

      allow create: if isAdmin()
        || (
          isPatient()
          && request.resource.data.patient_uid == request.auth.uid
          && request.resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id))
          && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.patient_uid == request.auth.uid
          && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.patient_id == patientIdFor(request.auth.uid)
          && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.status == 'Completed'
        );

      allow update, delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if isAdmin()
        || (isPatient() && resource.data.patient_uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isPatient() && resource.data.patient_uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // PAYMENT METHODS
    match /paymentMethods/{methodId} {
      allow read: if isAdmin()
        || (
          isPatient()
          && resource.data.status in ['Active', 'Setup']
        );
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.recipient_uid == request.auth.uid);

      allow create, delete: if isAdmin() || isDentist();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.recipient_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'readAt', 'updatedAt'
          ])
          && request.resource.data.recipient_uid == resource.data.recipient_uid
        );
    }

    // SUPPORT TICKETS
    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isPatient() && resource.data.patient_uid == request.auth.uid);

      allow create: if isAdmin()
        || (
          isPatient()
          && request.resource.data.patient_uid == request.auth.uid
          && request.resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.status == 'waiting'
        );

      allow update: if isAdmin()
        || (
          isPatient()
          && resource.data.patient_uid == request.auth.uid
          && resource.data.patient_id == patientIdFor(request.auth.uid)
          && request.resource.data.patient_uid == resource.data.patient_uid
          && request.resource.data.patient_id == resource.data.patient_id
          && resource.data.status != 'resolved'
          && request.resource.data.messages.size() == resource.data.messages.size() + 1
          && request.resource.data.messages[
            request.resource.data.messages.size() - 1
          ].sender_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'messages', 'preview', 'last_message', 'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    // PATIENT-DENTIST CONVERSATIONS
    match /conversations/{conversationId} {
      allow read: if isAdmin()
        || (signedIn() && isConversationParticipant(resource.data));

      allow create: if isPatient()
        && request.resource.data.patient_uid == request.auth.uid
        && request.resource.data.patient_id == patientIdFor(request.auth.uid)
        && request.resource.data.dentist_uid is string
        && request.resource.data.dentist_uid.size() > 0
        && activeDentistAccount(request.resource.data.dentist_uid);

      allow update: if isAdmin()
        || (
          isPatient()
          && resource.data.patient_uid == request.auth.uid
          && request.resource.data.patient_uid == resource.data.patient_uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'last_message', 'last_message_at', 'last_sender_uid',
            'updated_at', 'patient_read_at', 'dentist_read_at'
          ])
        )
        || (
          isDentist()
          && resource.data.dentist_uid == request.auth.uid
          && request.resource.data.dentist_uid == resource.data.dentist_uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'last_message', 'last_message_at', 'last_sender_uid',
            'updated_at', 'patient_read_at', 'dentist_read_at'
          ])
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConversation() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }

        allow read: if isAdmin()
          || (signedIn() && isConversationParticipant(parentConversation()));

        allow create: if signedIn()
          && isConversationParticipant(parentConversation())
          && request.resource.data.sender_uid == request.auth.uid
          && (
            (isPatient()
              && parentConversation().patient_uid == request.auth.uid
              && request.resource.data.sender_role == 'patient')
            || (isDentist()
              && parentConversation().dentist_uid == request.auth.uid
              && request.resource.data.sender_role == 'dentist')
          );

        allow update, delete: if isAdmin();
      }
    }

    // THESE COLLECTIONS ARE KEYED BY THE PERMANENT PT-ID.
    match /dentalCharts/{patientId} {
      allow read: if canAccessPatient(patientId);
      allow create, update: if isAdmin() || dentistAssignedToPatient(patientId);
      allow delete: if isAdmin();
    }

    match /dentalChartHistory/{patientId}/{document=**} {
      allow read: if canAccessPatient(patientId);
      allow write: if isAdmin() || dentistAssignedToPatient(patientId);
    }

    match /patientFiles/{patientId}/{document=**} {
      allow read: if canAccessPatient(patientId);
      allow write: if isAdmin() || dentistAssignedToPatient(patientId);
    }

    match /dentistPatientAccess/{accessId} {
      allow read: if isAdmin()
        || (isDentist() && resource.data.dentistId == dentistUid());
      allow write: if isAdmin();
    }

    match /consultations/{appointmentId} {
      allow read: if isAdmin()
        || (
          isDentist()
          && exists(/databases/$(database)/documents/appointments/$(appointmentId))
          && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.dentist_id
            == dentistUid()
        );
      allow create, update, delete: if isAdmin();
    }

    // EXISTING PATIENT ACCOUNT-LINK REQUESTS.
    // A pending requester can read only their own request, never the
    // corresponding clinical patient record.
    match /patientAccountLinkRequests/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && !userExists(uid)
        && !exists(linkRequestPath(uid))
        && request.resource.data.keys().hasAll([
          'patient_id', 'requester_uid', 'requester_email',
          'requester_name', 'phone', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'patient_id', 'requester_uid', 'requester_email',
          'requester_name', 'phone', 'status', 'createdAt'
        ])
        && request.resource.data.patient_id is string
        && request.resource.data.patient_id.matches('^PT-[A-Z0-9][A-Z0-9-]{0,23}$')
        && request.resource.data.requester_uid == uid
        && request.resource.data.requester_email == request.auth.token.email
        && request.resource.data.requester_name is string
        && request.resource.data.requester_name.size() >= 2
        && request.resource.data.requester_name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.status == 'Pending';

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid);

      allow update, delete: if isAdmin();
    }

    // Default: only Admin may access collections not explicitly listed above.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
